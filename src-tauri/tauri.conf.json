{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Linuxy",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "protocol": {
        "all": false,
        "asset": true,
        "assetScope": ["$HOME/.local/share/icons/**"]
      }
    },
    "bundle": {
      "active": true,
      "category": "Utility",
      "copyright": "Open Source - MIT License",
      "deb": {
        "depends": ["firejail", "xdg-utils"],
        "files": {},
        "desktopTemplate": "./debian/desktop-template.desktop"
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.linuxy.app",
      "longDescription": "Linuxy is a modern AppImage manager with one-click installation, Firejail sandboxing, optional delta updates, and secure desktop integration.",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "One-click AppImage Manager for Linux",
      "targets": "all",
      "windows": { "certificateThumbprint": null, "digestAlgorithm": "sha256", "timestampUrl": "" }
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https://appimage.github.io https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://appimage.github.io https://api.github.com https://avatars.githubusercontent.com; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Linuxy",
        "width": 800,
        "fileDropEnabled": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ]
  }
}
