# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size: 2

[*.json]
indent_size: 2

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2

[src-tauri/**/*.rs]
indent_size = 4

[*.toml]
indent_size = 4

[*.{js,ts,tsx,jsx}]
indent_size = 2

[*.css]
indent_size = 2

[*.html]
indent_size = 2
